# Shared secret for the internal REST API (web/catalog → this service)
AUTH_INTERNAL_KEY=

# Ory Kratos (shared instance, admin API)
KRATOS_ADMIN_URL=http://localhost:4434
# Public URL — needed for the passkey settings-flow proxy (recovery + settings flows)
KRATOS_PUBLIC_URL=http://localhost:4433

# Ory Hydra (shared instance, admin API) — login/consent/logout challenge proxy for
# whichever app hosts the /oauth/* UI (currently include-cookie-frontend)
HYDRA_ADMIN_URL=http://localhost:4445

# Telegram Bot API — widget/miniapp verification, chat-member checks, avatar download
BOT_TOKEN=

# Object storage (S3-compatible, RustFS in dev) — for the eager Telegram avatar download
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pandc

# Internal REST port (Docker network only — never published to the host)
HEALTH_PORT=8082
